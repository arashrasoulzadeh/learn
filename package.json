{
  "name": "learn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "new:concept": "node scripts/new-concept.mjs",
    "check:server": "node scripts/check-server-lessons.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run check:server && npm run check:network && npm run check:backend && npm run check:data && npm run check:data-exercises && npm run check:deep && npm run check:advanced && npm run check && npm run build && npm run test:e2e",
    "check:network": "node --experimental-strip-types scripts/check-network-lessons.mjs",
    "check:backend": "node --experimental-strip-types scripts/check-backend-lessons.mjs",
    "check:data": "node --experimental-strip-types scripts/check-data-lessons.mjs",
    "check:data-exercises": "python3 scripts/check-data-exercises.py",
    "check:deep": "node --experimental-strip-types scripts/check-deep-lessons.mjs",
    "check:advanced": "node --experimental-strip-types scripts/check-advanced-lessons.mjs"
  },
  "dependencies": {
    "astro": "7.4.13",
    "@astrojs/mdx": "8.1.6",
    "@astrojs/react": "7.1.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "pagefind": "^1.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "^5.8.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@playwright/test": "^1.57.0",
    "@axe-core/playwright": "^4.10.2"
  }
}
