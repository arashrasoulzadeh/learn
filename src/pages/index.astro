---
import LessonScreen from '../layouts/LessonScreen.astro';
import { catalog } from '../lib/content';
const { concepts } = await catalog();
const lesson = concepts.find(c=>c.id==='networking/http-request') ?? concepts[0];
if (!lesson) throw new Error('Publish at least one lesson.');
---
<LessonScreen lesson={lesson} isHome={true} />
