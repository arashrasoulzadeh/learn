---
import LessonScreen from '../../layouts/LessonScreen.astro';
import { catalog, type Lesson } from '../../lib/content';
export async function getStaticPaths() {
  const { concepts } = await catalog();
  return concepts.map(lesson=>({params:{id:lesson.id},props:{lesson}}));
}
const { lesson } = Astro.props as { lesson: Lesson };
---
<LessonScreen lesson={lesson} />
