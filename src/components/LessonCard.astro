---
import { lessonUrl, type Lesson } from '../lib/content';
const { lesson } = Astro.props as { lesson: Lesson };
const levels={beginner:'مقدماتی',intermediate:'متوسط',advanced:'پیشرفته'};
---
<a class="lesson-card" href={lessonUrl(lesson.id)} data-lesson={lesson.id}>
  <div class="eyebrow">{levels[lesson.data.difficulty]} · {lesson.data.estimatedMinutes.toLocaleString('fa-IR')} دقیقه</div>
  <h3>{lesson.data.title}</h3>
  <p>{lesson.data.description}</p>
  <div class="card-bottom"><span data-progress={lesson.id}>آموزش تعاملی</span><span aria-hidden="true">↗</span></div>
</a>
<script>
  document.querySelectorAll<HTMLElement>('[data-progress]').forEach(el=>{
    try { if(localStorage.getItem('learn.complete.'+el.dataset.progress)==='1') el.textContent='✓ تکمیل شده'; } catch {}
  });
</script>
