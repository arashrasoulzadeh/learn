---
import { catalog, lessonUrl, type Lesson } from '../../lib/content';
import Popover from './Popover.astro';
const { currentId } = Astro.props as {currentId:string};
const pickerIds = ['networking/http-request'];
const { concepts } = await catalog();
const pickerLessons = pickerIds.map(id=>concepts.find(item=>item.id===id)).filter((item):item is Lesson=>!!item);
---
<Popover label="انتخاب درس" id="lesson-picker"><svg slot="icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><path d="M12 5C9 3 5 3 2 4v15c3-1 7-1 10 1 3-2 7-2 10-1V4c-3-1-7-1-10 1Zm0 0v15"/></svg>
  <nav aria-label="درس‌های قابل انتخاب"><p class="picker-heading">درس‌های آموزشی</p>
    {pickerLessons.map(item=><a href={lessonUrl(item.id)} aria-current={item.id===currentId?'page':undefined}>{item.data.title}{item.id===currentId&&<span aria-hidden="true">✓</span>}</a>)}
  </nav>
</Popover>
<style>
  .picker-heading{font-size:12px;color:var(--muted);margin:2px 6px 8px}
  a{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:12px 10px;border:1px solid transparent;border-radius:9px;color:var(--ink);font-size:14px;line-height:1.6}
  a[aria-current=page]{border-color:#79e3c133}
  a:hover,a[aria-current=page]{background:var(--panel2);color:var(--accent);text-decoration:none}
</style>
