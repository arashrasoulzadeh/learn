---
const { src, title, captions, poster } = Astro.props as {src:string;title:string;captions?:string;poster?:string};
---
<figure><video class="video-frame" controls preload="metadata" aria-label={title} poster={poster} playsinline><source src={src} />{captions&&<track kind="captions" src={captions} srclang="fa" label="فارسی" default/>}مرورگر شما از پخش ویدیو پشتیبانی نمی‌کند.</video><figcaption>{title}</figcaption></figure>
