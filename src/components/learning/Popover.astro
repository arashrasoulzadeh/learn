---
const {label,id}=Astro.props as {label:string;id:string};
---
<details class="learning-popover" id={id} data-pagefind-ignore>
  <summary><slot name="icon"/>{label}<svg class="popover-chevron" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
  <div class="learning-popover-content"><slot /></div>
</details>
<script>
  document.querySelectorAll<HTMLDetailsElement>('.learning-popover').forEach(popup=>{
    document.addEventListener('click',event=>{
      if(popup.open && event.target instanceof Node && !popup.contains(event.target))popup.open=false;
    });
    popup.addEventListener('keydown',event=>{
      if(event.key==='Escape' && popup.open){popup.open=false;popup.querySelector('summary')?.focus();}
    });
  });
</script>
<style>
  .learning-popover{position:relative;flex:none;z-index:10}
  .learning-popover[open]{z-index:11}
  summary{list-style:none;display:flex;align-items:center;gap:7px;cursor:pointer;white-space:nowrap;border:1px solid var(--line);border-radius:11px;background:var(--panel);color:var(--ink);padding:9px 12px;font-size:13px;font-weight:600;min-height:42px;transition:border-color .15s,background .15s}
  summary::-webkit-details-marker{display:none}
  summary:hover,details[open] summary{border-color:var(--accent)}
  summary:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
  details[open] .popover-chevron{transform:rotate(180deg)}
  .popover-chevron{color:var(--muted);transition:transform .15s;flex:none}
  .learning-popover-content{position:absolute;inset-inline-end:0;top:calc(100% + 8px);width:min(320px,calc(100vw - 24px));padding:12px;border:1px solid var(--line);border-radius:14px;background:var(--panel);box-shadow:0 18px 45px #0007;text-align:start;direction:rtl}
  @media(max-width:600px){.learning-popover{position:static}.learning-popover-content{inset-inline-end:0;top:100%;margin-top:8px}}
</style>
