---
import '../styles/global.css';
import { renderLesson, lessonUrl, type Lesson } from '../lib/content';
const { lesson, isHome = false } = Astro.props as { lesson: Lesson; isHome?: boolean };
const { Content } = await renderLesson(lesson);
const canonical = new URL(lessonUrl(lesson.id), Astro.site);
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={lesson.data.description} />
  <meta name="theme-color" content="#10141e" />
  <link rel="canonical" href={canonical} />
  <title>{lesson.data.title}</title>
</head>
<body class="learning-page">
  <main class="learning-screen" data-pagefind-body={isHome ? undefined : ''} data-pagefind-ignore={isHome ? 'all' : undefined}>
    <header class="learning-title"><h1>{lesson.data.title}</h1></header>
    <div class="learning-content"><Content /></div>
  </main>
</body>
</html>
